class Solution:
    def isValid(self, s: str) -> bool:
        stack = []

        for char in s:
            if char in "({[":
                stack.append(char)

            if char == ")":
                if not stack or stack.pop() != "(":
                    return False

            if char == "]":
                if not stack or stack.pop() != "[":
                    return False

            if char == "}":
                if not stack or stack.pop() != "{":
                    return False

        return len(stack) == 0
